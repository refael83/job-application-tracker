# Copy this file to .env and fill in the values (.env is not committed to git)

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=job_tracker

# --- Email scanning (IMAP) - optional ---
# For Gmail: turn on 2-step verification, then create an "app password" at
# https://myaccount.google.com/apppasswords  (NOT your regular account password!)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Email classification with Claude - optional ---
# Default: if Claude Code is installed and logged in (the `claude` command), classification runs through it
# on your subscription, with no API key. If ANTHROPIC_API_KEY is set it is used instead (pay per use).
# You can force a provider with AI_PROVIDER=cli or AI_PROVIDER=api
AI_PROVIDER=
CLAUDE_CLI_MODEL=haiku
# An API key from https://console.anthropic.com/ (billed per use). When "use AI" is ticked for a scan,
# only the sender, the subject and the first 2,000 characters of emails that passed filtering are sent to Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
